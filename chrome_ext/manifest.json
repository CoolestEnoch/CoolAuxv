{
  "manifest_version": 3,
  "name": "CoolAuxv 网页翻译与阅读助手",
  "version": "16.4",
  "description": "网页翻译与阅读助手（Chromium 类浏览器扩展版，基于 CoolAuxv 用户脚本）。",
  "permissions": ["clipboardWrite", "storage", "tabs", "webNavigation", "webRequest", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "gm_polyfill.js",
        "vendor/marked.min.js",
        "vendor/html2canvas.min.js",
        "vendor/katex.min.js",
        "vendor/auto-render.min.js",
        "vendor/mermaid.min.js",
        "coolauxv.user.js"
      ],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/mermaid.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "CoolAuxv"
  }
}
